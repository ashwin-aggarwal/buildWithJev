# Copy this file to .env and fill in your key(s). NEVER commit .env.
# .env is gitignored.

# --- Required (default transport: OpenRouter) -------------------------------
# Get this from https://openrouter.ai/keys  (see SETUP.md).
OPENROUTER_API_KEY=

# --- Optional overrides -----------------------------------------------------
# Pinned model version. Leave as-is unless you deliberately want a different build.
# JEV_MODEL_ID=typesafe/jev-1.13

# Transport: "openrouter" (default) or "typesafe".
# JEV_PROVIDER=openrouter

# Only needed if JEV_PROVIDER=typesafe (TypeSafe's own API, api.typesafe.ai).
# TYPESAFE_API_KEY=

# --- Character extraction (one Anthropic call per book) ---------------------
# Only needed for `python -m detective_jev.cli roster <book_id>` when no
# data/rosters/<book_id>.yaml exists yet.
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-sonnet-5
