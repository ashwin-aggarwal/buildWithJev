# Copy this file to .env and fill in your key(s). NEVER commit .env.
# .env is gitignored.

# --- Required (default transport: OpenRouter) -------------------------------
# Get this from https://openrouter.ai/keys  (see SETUP.md).
OPENROUTER_API_KEY=

# --- Optional overrides -----------------------------------------------------
# Pinned model version. Leave as-is unless you deliberately want a different build.
# JEV_MODEL_ID=typesafe/jev-1.13

# Transport: "openrouter" (default) or "typesafe".
# JEV_PROVIDER=openrouter

# How many recent chunks Jev sees in FULL text at each step (default 3).
# 1 = original design: compressed notes for 1..t-1 plus only chunk t.
# RAW_WINDOW=3

# Only needed if JEV_PROVIDER=typesafe (TypeSafe's own API, api.typesafe.ai).
# TYPESAFE_API_KEY=

# --- Character extraction (one LLM call per book) ---------------------------
# Only needed for `python -m detective_jev.cli roster <book_id>` when no
# data/rosters/<book_id>.yaml exists yet.
#
# Backend: "anthropic" (default; needs ANTHROPIC_API_KEY) or "openrouter"
# (reuses OPENROUTER_API_KEY above — no Anthropic key required). Use openrouter
# if you only have an OpenRouter key.
# EXTRACTION_PROVIDER=anthropic

# Anthropic path:
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-sonnet-5

# OpenRouter path (needs a large-context model; the whole novel is sent at once):
# OPENROUTER_EXTRACTION_MODEL=deepseek/deepseek-v4-flash
# Hidden "thinking" for that model: none (default), minimal, low, medium, high.
# Leave it at none: with thinking on, the model can use its whole output budget
# thinking and return an empty character list.
# OPENROUTER_EXTRACTION_REASONING=none
